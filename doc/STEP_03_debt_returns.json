{
  "info": {
    "name": "Jango Step 03 Debt Returns",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create debt walk-in order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "token", "value": "{{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"customer_name\": \"Amina\", \"customer_phone\": \"0700000001\", \"payment_method\": \"Debt\", \"items\": [{ \"product_id\": 1, \"quantity\": 1 }] }"
        },
        "url": "{{baseUrl}}/api/vendor/manual-orders"
      }
    },
    {
      "name": "Pay debt",
      "request": {
        "method": "POST",
        "header": [
          { "key": "token", "value": "{{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"amount\": 40 }"
        },
        "url": "{{baseUrl}}/api/vendor/manual-orders/1/pay-debt"
      }
    },
    {
      "name": "Request walk-in return",
      "request": {
        "method": "POST",
        "header": [
          { "key": "token", "value": "{{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"reason\": \"Damaged\", \"quantity\": 1, \"refund_method\": \"cash\" }"
        },
        "url": "{{baseUrl}}/api/vendor/orders/1/refund"
      }
    }
  ]
}
